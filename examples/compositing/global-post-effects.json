{
  "schema_version": 1,
  "name": "Global post effects",
  "output": {
    "path": "../output/global-post-effects.mp4",
    "width": 320,
    "height": 180,
    "frame_rate": 30,
    "background": "#101018",
    "quality": "preview",
    "audio": false,
    "duration_mode": "explicit",
    "duration": 5
  },
  "assets": [
    {
      "id": "red",
      "type": "image",
      "source": "../assets/red.png"
    }
  ],
  "visual": {
    "clips": [
      {
        "id": "clip",
        "source": {
          "type": "image",
          "asset": "red"
        },
        "start": 0,
        "duration": 5,
        "layer": 0,
        "sizing": {
          "mode": "cover"
        },
        "transform": {
          "position": {
            "base_value": {
              "x": 0.5,
              "y": 0.5
            }
          },
          "anchor": {
            "base_value": {
              "x": 0.5,
              "y": 0.5
            }
          },
          "scale": {
            "base_value": {
              "x": 1,
              "y": 1
            }
          }
        },
        "opacity": {
          "base_value": 1
        }
      }
    ],
    "post_effects": [
      {
        "id": "grade",
        "type": "color_adjust",
        "exposure": {
          "base_value": 0.1
        },
        "gamma": {
          "base_value": 1
        },
        "black_point": {
          "base_value": 0
        },
        "white_point": {
          "base_value": 1
        }
      },
      {
        "id": "vignette",
        "type": "vignette",
        "amount": {
          "base_value": 0.2
        },
        "radius": {
          "base_value": 0.7
        },
        "softness": {
          "base_value": 0.3
        },
        "colour": "#000000"
      }
    ]
  }
}
