{
  "schema_version": 2,
  "name": "Motion blur",
  "output": {
    "path": "../output/motion-blur.mp4",
    "width": 320,
    "height": 180,
    "frame_rate": 30,
    "background": "#101018",
    "quality": "preview",
    "audio": false,
    "duration_mode": "explicit",
    "duration": 5
  },
  "assets": [
    {
      "id": "red",
      "type": "image",
      "source": "../assets/red.png"
    }
  ],
  "visual": {
    "clips": [
      {
        "id": "clip",
        "source": {
          "type": "image",
          "asset": "red"
        },
        "start": 0,
        "duration": 5,
        "layer": 0,
        "sizing": {
          "mode": "cover"
        },
        "transform": {
          "position": {
            "base_value": {
              "x": 0.4,
              "y": 0.5
            },
            "keyframes": [
              {
                "time": 1,
                "value": {
                  "x": 0.35,
                  "y": 0.5
                },
                "interpolation": "linear"
              },
              {
                "time": 3.5,
                "value": {
                  "x": 0.65,
                  "y": 0.5
                },
                "interpolation": "ease_in_out"
              }
            ]
          },
          "anchor": {
            "base_value": {
              "x": 0.5,
              "y": 0.5
            }
          },
          "scale": {
            "base_value": {
              "x": 1,
              "y": 1
            }
          }
        },
        "opacity": {
          "base_value": 1
        },
        "effects": [
          {
            "id": "motion",
            "type": "motion_blur",
            "intensity": {
              "base_value": 0,
              "keyframes": [
                {
                  "time": 1,
                  "value": 0,
                  "interpolation": "linear"
                },
                {
                  "time": 2.25,
                  "value": 0.8,
                  "interpolation": "ease_in_out"
                },
                {
                  "time": 3.5,
                  "value": 0,
                  "interpolation": "ease_in_out"
                }
              ]
            },
            "shutter_angle": {
              "base_value": 180
            },
            "max_radius": {
              "base_value": 16
            },
            "samples": 8
          }
        ]
      }
    ]
  }
}
