{
  "schema_version": 4,
  "name": "Focus reveal preset",
  "output": {
    "path": "../output/focus-reveal.mp4",
    "width": 320,
    "height": 180,
    "frame_rate": 30,
    "background": "#101018",
    "quality": "preview",
    "audio": false,
    "duration_mode": "explicit",
    "duration": 5
  },
  "assets": [
    {
      "id": "red",
      "type": "image",
      "source": "../assets/red.png"
    }
  ],
  "visual": {
