        "start": 0,
        "duration": 5,
        "layer": 0,
        "sizing": {
          "mode": "cover"
        },
        "transform": {
          "position": {
            "base_value": {
              "x": 0.5,
              "y": 0.5
            }
          },
          "anchor": {
            "base_value": {
              "x": 0.5,
              "y": 0.5
            }
          },
          "scale": {
            "base_value": {
              "x": 1,
              "y": 1
            }
          }
        },
        "opacity": {
          "base_value": 1
        },
        "preset": {
          "type": "focus_reveal",
          "intensity": 1,
          "start": 1.5,
          "duration": 0.8
        }
      }
    ]
  }
}
