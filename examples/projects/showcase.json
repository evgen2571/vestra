{
  "format_version": 1,
  "name": "Version 1 feature showcase",
  "output": {
    "path": "../output/showcase.mp4",
    "width": 320,
    "height": 180,
    "frame_rate": "24/1",
    "background": "#1A1A28",
    "quality": "balanced",
    "audio": true,
    "duration_mode": "automatic"
  },
  "assets": [
    { "id": "red", "type": "image", "source": "../assets/red.png" },
    { "id": "green", "type": "image", "source": "../assets/green.png" },
    { "id": "blue", "type": "image", "source": "../assets/blue.png" },
    { "id": "tone", "type": "audio", "source": "../assets/tone.wav" }
  ],
  "visual": {
    "clips": [
      {
        "id": "red-entry",
        "asset": "red",
        "start": 0,
        "duration": 1.5,
        "layer": 0,
        "position": { "x": 0.3, "y": 0.5 },
        "anchor": { "x": 0.5, "y": 0.5 },
        "sizing": { "mode": "fit" },
        "opacity": 1,
        "animations": [
          { "target": "position", "start_value": { "x": -0.1, "y": 0.5 }, "end_value": { "x": 0.3, "y": 0.5 }, "start": 0, "duration": 0.6, "easing": "ease_out" },
          { "target": "opacity", "start_value": 0, "end_value": 1, "start": 0, "duration": 0.3, "easing": "linear" }
        ]
      },
      {
        "id": "blue-cover",
        "asset": "blue",
        "start": 1,
        "duration": 1.5,
        "layer": 0,
        "position": { "x": 0.5, "y": 0.5 },
        "anchor": { "x": 0.5, "y": 0.5 },
        "sizing": { "mode": "cover" },
        "crop": { "x": 0.1, "y": 0, "width": 0.8, "height": 1 },
        "opacity": 1,
        "animations": [
          { "target": "scale", "start_value": 1, "end_value": 1.2, "start": 0, "duration": 1.2, "easing": "ease_in_out" },
          { "target": "position", "start_value": { "x": 0.45, "y": 0.5 }, "end_value": { "x": 0.55, "y": 0.5 }, "start": 0, "duration": 1.2, "easing": "ease_in_out" },
          { "target": "crop", "start_value": { "x": 0.1, "y": 0, "width": 0.8, "height": 1 }, "end_value": { "x": 0.2, "y": 0, "width": 0.8, "height": 1 }, "start": 0.2, "duration": 0.8, "easing": "linear" }
        ]
      },
      {
        "id": "green-overlay",
        "asset": "green",
        "start": 2.2,
        "duration": 1.1,
        "layer": 1,
        "position": { "x": 0.5, "y": 0.5 },
        "anchor": { "x": 0.5, "y": 0.5 },
        "sizing": { "mode": "stretch", "width": 100, "height": 100 },
        "opacity": 0.8,
        "animations": [
          { "target": "position", "start_value": { "x": 0.5, "y": 1.2 }, "end_value": { "x": 0.5, "y": 0.5 }, "start": 0, "duration": 0.7, "easing": "ease_in" }
        ]
      }
    ],
    "transitions": [
      { "type": "crossfade", "id": "red-to-blue", "outgoing": "red-entry", "incoming": "blue-cover", "start": 1, "duration": 0.5, "easing": "linear" },
      { "type": "fade_to_background", "id": "blue-fade", "clip": "blue-cover", "start": 2, "duration": 0.3, "easing": "ease_in" },
      { "type": "fade_from_background", "id": "green-fade", "clip": "green-overlay", "start": 2.2, "duration": 0.3, "easing": "ease_out" }
    ],
    "flashes": [
      { "id": "accent", "start": 2.65, "duration": 0.2, "colour": "#FFFFFF", "opacity": 0.35, "fade_in": 0.05, "fade_out": 0.1, "layer": 2 }
    ]
  },
  "audio": {
    "asset": "tone",
    "timeline_start": 0.1,
    "trim_start": 0.2,
    "trim_end": 3.2,
    "volume": 0.25,
    "fade_in": 0.15,
    "fade_out": 0.2,
    "mute": false
  }
}
