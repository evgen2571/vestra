{
  "format_version": 1,
  "name": "Static image",
  "output": {
    "path": "../output/static-image.mp4",
    "width": 320,
    "height": 180,
    "frame_rate": 24,
    "background": "#202020",
    "quality": "balanced",
    "audio": false,
    "duration_mode": "automatic"
  },
  "assets": [
    { "id": "red", "type": "image", "source": "../assets/red.png" }
  ],
  "visual": {
    "clips": [
      {
        "id": "red-still",
        "asset": "red",
        "start": 0,
        "duration": 1,
        "layer": 0,
        "position": { "x": 0.5, "y": 0.5 },
        "anchor": { "x": 0.5, "y": 0.5 },
        "sizing": { "mode": "original" },
        "opacity": 1
      }
    ]
  }
}
