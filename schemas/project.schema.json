{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/video-editor/project.schema.json",
  "title": "Declarative Video Renderer Project",
  "type": "object",
  "required": ["output", "assets", "visual"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "metadata": { "not": { "type": "null" } },
    "output": { "$ref": "#/$defs/output" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "audio": { "$ref": "#/$defs/audio" },
    "visual": { "$ref": "#/$defs/visual" }
  },
  "$defs": {
    "colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
    "point": { "type": "object", "required": ["x", "y"], "additionalProperties": false, "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "crop": { "type": "object", "required": ["x", "y", "width", "height"], "additionalProperties": false, "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" } } },
    "scalar_track": { "type": "object", "required": ["base_value"], "additionalProperties": false, "properties": { "base_value": { "type": "number" }, "keyframes": { "type": "array", "items": { "$ref": "#/$defs/scalar_keyframe" } } } },
    "point_track": { "type": "object", "required": ["base_value"], "additionalProperties": false, "properties": { "base_value": { "$ref": "#/$defs/point" }, "keyframes": { "type": "array", "items": { "$ref": "#/$defs/point_keyframe" } } } },
    "opacity_track": { "type": "object", "required": ["base_value"], "additionalProperties": false, "properties": { "base_value": { "type": "number", "minimum": 0, "maximum": 1 }, "keyframes": { "type": "array", "items": { "$ref": "#/$defs/unit_scalar_keyframe" } } } },
    "anchor_track": { "type": "object", "required": ["base_value"], "additionalProperties": false, "properties": { "base_value": { "$ref": "#/$defs/unit_point" }, "keyframes": { "type": "array", "items": { "$ref": "#/$defs/unit_point_keyframe" } } } },
    "scale_track": { "type": "object", "required": ["base_value"], "additionalProperties": false, "properties": { "base_value": { "$ref": "#/$defs/positive_point" }, "keyframes": { "type": "array", "items": { "$ref": "#/$defs/positive_point_keyframe" } } } },
    "crop_track": { "type": "object", "required": ["base_value"], "additionalProperties": false, "properties": { "base_value": { "$ref": "#/$defs/crop" }, "keyframes": { "type": "array", "items": { "$ref": "#/$defs/crop_keyframe" } } } },
    "interpolation": { "oneOf": [ { "enum": ["linear", "hold", "ease_in", "ease_out", "ease_in_out"] }, { "type": "object", "required": ["type", "x1", "y1", "x2", "y2"], "additionalProperties": false, "properties": { "type": { "const": "cubic_bezier" }, "x1": { "type": "number", "minimum": 0, "maximum": 1 }, "y1": { "type": "number" }, "x2": { "type": "number", "minimum": 0, "maximum": 1 }, "y2": { "type": "number" } } } ] },
    "scalar_keyframe": { "type": "object", "required": ["time", "value", "interpolation"], "additionalProperties": false, "properties": { "time": { "type": "number", "minimum": 0 }, "value": { "type": "number" }, "interpolation": { "$ref": "#/$defs/interpolation" } } },
    "point_keyframe": { "type": "object", "required": ["time", "value", "interpolation"], "additionalProperties": false, "properties": { "time": { "type": "number", "minimum": 0 }, "value": { "$ref": "#/$defs/point" }, "interpolation": { "$ref": "#/$defs/interpolation" } } },
    "unit_scalar_keyframe": { "type": "object", "required": ["time", "value", "interpolation"], "additionalProperties": false, "properties": { "time": { "type": "number", "minimum": 0 }, "value": { "type": "number", "minimum": 0, "maximum": 1 }, "interpolation": { "$ref": "#/$defs/interpolation" } } },
    "unit_point_keyframe": { "type": "object", "required": ["time", "value", "interpolation"], "additionalProperties": false, "properties": { "time": { "type": "number", "minimum": 0 }, "value": { "$ref": "#/$defs/unit_point" }, "interpolation": { "$ref": "#/$defs/interpolation" } } },
    "positive_point_keyframe": { "type": "object", "required": ["time", "value", "interpolation"], "additionalProperties": false, "properties": { "time": { "type": "number", "minimum": 0 }, "value": { "$ref": "#/$defs/positive_point" }, "interpolation": { "$ref": "#/$defs/interpolation" } } },
    "crop_keyframe": { "type": "object", "required": ["time", "value", "interpolation"], "additionalProperties": false, "properties": { "time": { "type": "number", "minimum": 0 }, "value": { "$ref": "#/$defs/crop" }, "interpolation": { "$ref": "#/$defs/interpolation" } } },
    "unit_point": { "type": "object", "required": ["x", "y"], "additionalProperties": false, "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "positive_point": { "type": "object", "required": ["x", "y"], "additionalProperties": false, "properties": { "x": { "type": "number", "exclusiveMinimum": 0 }, "y": { "type": "number", "exclusiveMinimum": 0 } } },
    "output": { "type": "object", "required": ["path", "width", "height", "frame_rate", "background", "quality", "audio", "duration_mode"], "additionalProperties": false, "properties": { "path": { "type": "string" }, "width": { "type": "integer", "minimum": 2 }, "height": { "type": "integer", "minimum": 2 }, "frame_rate": { "oneOf": [ { "type": "number", "exclusiveMinimum": 0 }, { "type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$" } ] }, "background": { "$ref": "#/$defs/colour" }, "quality": { "enum": ["preview", "balanced", "high"] }, "audio": { "type": "boolean" }, "duration_mode": { "enum": ["automatic", "explicit"] }, "duration": { "type": "number", "exclusiveMinimum": 0 } } },
    "asset": { "type": "object", "required": ["id", "type", "source"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "enum": ["image", "audio"] }, "source": { "type": "string", "minLength": 1 } } },
    "audio": { "type": "object", "required": ["asset", "timeline_start", "trim_start", "volume"], "additionalProperties": false, "properties": { "asset": { "type": "string" }, "timeline_start": { "type": "number", "minimum": 0 }, "trim_start": { "type": "number", "minimum": 0 }, "trim_end": { "type": "number", "minimum": 0 }, "volume": { "type": "number", "minimum": 0 }, "fade_in": { "type": "number", "minimum": 0 }, "fade_out": { "type": "number", "minimum": 0 }, "mute": { "type": "boolean" } } },
    "source": { "oneOf": [ { "type": "object", "required": ["type", "asset"], "additionalProperties": false, "properties": { "type": { "const": "image" }, "asset": { "type": "string", "minLength": 1 } } }, { "type": "object", "required": ["type", "colour"], "additionalProperties": false, "properties": { "type": { "const": "solid_color" }, "colour": { "$ref": "#/$defs/colour" } } } ] },
    "sizing": { "oneOf": [ { "type": "object", "required": ["mode"], "additionalProperties": false, "properties": { "mode": { "enum": ["original", "fit", "cover"] } } }, { "type": "object", "required": ["mode", "scale"], "additionalProperties": false, "properties": { "mode": { "const": "scale" }, "scale": { "type": "number", "exclusiveMinimum": 0 } } }, { "type": "object", "required": ["mode", "width", "height"], "additionalProperties": false, "properties": { "mode": { "const": "stretch" }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } } ] },
    "transform": { "type": "object", "required": ["position", "anchor", "scale"], "additionalProperties": false, "properties": { "position": { "$ref": "#/$defs/point_track" }, "anchor": { "$ref": "#/$defs/anchor_track" }, "scale": { "$ref": "#/$defs/scale_track" }, "rotation_degrees": { "$ref": "#/$defs/scalar_track" } } },
    "effect": { "oneOf": [ { "type": "object", "required": ["id", "type", "amount"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "enum": ["brightness", "contrast", "saturation"] }, "amount": { "$ref": "#/$defs/scalar_track" } } }, { "type": "object", "required": ["id", "type", "colour", "amount"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "const": "tint" }, "colour": { "$ref": "#/$defs/colour" }, "amount": { "$ref": "#/$defs/opacity_track" } } }, { "type": "object", "required": ["id", "type"], "additionalProperties": true, "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "enum": ["gaussian_blur", "directional_blur", "glow", "chromatic_aberration", "vignette", "sharpen", "color_adjust", "camera_shake", "motion_blur"] }, "radius": { "$ref": "#/$defs/scalar_track" }, "amount": { "$ref": "#/$defs/scalar_track" }, "angle_degrees": { "$ref": "#/$defs/scalar_track" }, "threshold": { "$ref": "#/$defs/scalar_track" }, "intensity": { "$ref": "#/$defs/scalar_track" }, "colour": { "$ref": "#/$defs/colour" }, "exposure": { "$ref": "#/$defs/scalar_track" }, "gamma": { "$ref": "#/$defs/scalar_track" }, "black_point": { "$ref": "#/$defs/scalar_track" }, "white_point": { "$ref": "#/$defs/scalar_track" } } } ] },
    "clip": { "type": "object", "required": ["id", "source", "start", "duration", "layer", "opacity"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "source": { "$ref": "#/$defs/source" }, "start": { "type": "number", "minimum": 0 }, "duration": { "type": "number", "exclusiveMinimum": 0 }, "layer": { "type": "integer" }, "visible": { "type": "boolean" }, "sizing": { "$ref": "#/$defs/sizing" }, "crop": { "$ref": "#/$defs/crop_track" }, "transform": { "$ref": "#/$defs/transform" }, "opacity": { "$ref": "#/$defs/opacity_track" }, "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } }, "blend_mode": { "enum": ["normal", "add", "screen", "multiply", "overlay"] } }, "allOf": [ { "if": { "properties": { "source": { "properties": { "type": { "const": "image" } }, "required": ["type"] } }, "required": ["source"] }, "then": { "required": ["transform"] }, "else": { "not": { "required": ["transform"] } } } ] },
    "transition": { "type": "object", "required": ["type", "id", "outgoing", "incoming", "start", "duration", "interpolation"], "additionalProperties": true, "properties": { "type": { "enum": ["crossfade", "zoom_crossfade", "flash_cut", "directional_push", "zoom_blur"] }, "id": { "type": "string", "minLength": 1 }, "outgoing": { "type": "string", "minLength": 1 }, "incoming": { "type": "string", "minLength": 1 }, "start": { "type": "number", "minimum": 0 }, "duration": { "type": "number", "exclusiveMinimum": 0 }, "interpolation": { "$ref": "#/$defs/interpolation" } } },
    "flash": { "type": "object", "required": ["id", "start", "duration", "colour", "opacity", "layer"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "start": { "type": "number", "minimum": 0 }, "duration": { "type": "number", "exclusiveMinimum": 0 }, "colour": { "$ref": "#/$defs/colour" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "fade_in": { "type": "number", "minimum": 0 }, "fade_out": { "type": "number", "minimum": 0 }, "layer": { "type": "integer" } } },
    "visual": { "type": "object", "required": ["clips"], "additionalProperties": false, "properties": { "clips": { "type": "array", "items": { "$ref": "#/$defs/clip" } }, "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } }, "flashes": { "type": "array", "items": { "$ref": "#/$defs/flash" } }, "post_effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } } } }
  }
}
