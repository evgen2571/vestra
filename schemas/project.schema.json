{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/video-editor/project.schema.json",
  "title": "Declarative Video Renderer Project",
  "type": "object",
  "required": [
    "schema_version",
    "output",
    "assets",
    "visual"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "name": {
      "type": "string"
    },
    "metadata": {
      "not": {
        "type": "null"
      }
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "audio": {
      "$ref": "#/$defs/audio"
    },
    "visual": {
      "$ref": "#/$defs/visual"
    }
  },
  "$defs": {
    "colour": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "crop": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "scalar_track": {
      "type": "object",
      "required": [
        "base_value"
      ],
      "additionalProperties": false,
      "properties": {
        "base_value": {
          "type": "number"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scalar_keyframe"
          }
        }
      }
    },
    "scalar_property": {
      "type": "object",
      "required": ["base_value"],
      "additionalProperties": false,
      "properties": {
        "base_value": { "type": "number" },
        "keyframes": { "type": "array", "items": { "$ref": "#/$defs/scalar_keyframe" } },
        "modifiers": { "type": "array", "items": { "$ref": "#/$defs/scalar_modifier" } }
      }
    },
    "opacity_property": {
      "type": "object",
      "required": ["base_value"],
      "additionalProperties": false,
      "properties": {
        "base_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "keyframes": { "type": "array", "items": { "$ref": "#/$defs/unit_scalar_keyframe" } },
        "modifiers": { "type": "array", "items": { "$ref": "#/$defs/scalar_modifier" } }
      }
    },
    "unit_scalar_property": {
      "type": "object",
      "required": ["base_value"],
      "additionalProperties": false,
      "properties": {
        "base_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "keyframes": { "type": "array", "items": { "$ref": "#/$defs/unit_scalar_keyframe" } },
        "modifiers": { "type": "array", "items": { "$ref": "#/$defs/scalar_modifier" } }
      }
    },
    "scalar_modifier": {
      "type": "object",
      "required": ["operation", "signal"],
      "additionalProperties": false,
      "properties": {
        "operation": { "enum": ["replace", "add", "multiply"] },
        "signal": { "$ref": "#/$defs/scalar_signal" }
      }
    },
    "scalar_signal": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/scalar_signal_source" },
        "transforms": { "type": "array", "items": { "$ref": "#/$defs/signal_transform" } }
      }
    },
    "scalar_signal_source": {
      "type": "object",
      "required": ["type", "tap", "feature"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "audio" },
        "tap": { "const": "master" },
        "feature": { "$ref": "#/$defs/audio_scalar_feature" }
      }
    },
    "audio_scalar_feature": {
      "oneOf": [
        { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "rms" } } },
        { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "peak" } } },
        { "type": "object", "required": ["type", "min_hz", "max_hz"], "additionalProperties": false, "properties": { "type": { "const": "band_energy" }, "min_hz": { "type": "number", "minimum": 0 }, "max_hz": { "type": "number", "maximum": 24000 } } }
      ]
    },
    "signal_transform": {
      "oneOf": [
        { "type": "object", "required": ["type", "gain"], "additionalProperties": false, "properties": { "type": { "const": "gain" }, "gain": { "type": "number" } } },
        { "type": "object", "required": ["type", "input_min", "input_max", "output_start", "output_end"], "additionalProperties": false, "properties": { "type": { "const": "remap" }, "input_min": { "type": "number" }, "input_max": { "type": "number" }, "output_start": { "type": "number" }, "output_end": { "type": "number" } } },
        { "type": "object", "required": ["type", "min", "max"], "additionalProperties": false, "properties": { "type": { "const": "clamp" }, "min": { "type": "number" }, "max": { "type": "number" } } },
        { "type": "object", "required": ["type", "attack", "release"], "additionalProperties": false, "properties": { "type": { "const": "envelope" }, "attack": { "type": "number", "minimum": 0 }, "release": { "type": "number", "minimum": 0 } } },
        { "type": "object", "required": ["type", "x1", "y1", "x2", "y2"], "additionalProperties": false, "properties": { "type": { "const": "response_curve" }, "x1": { "type": "number", "minimum": 0, "maximum": 1 }, "y1": { "type": "number" }, "x2": { "type": "number", "minimum": 0, "maximum": 1 }, "y2": { "type": "number" } } }
      ]
    },
    "point_track": {
      "type": "object",
      "required": [
        "base_value"
      ],
      "additionalProperties": false,
      "properties": {
        "base_value": {
          "$ref": "#/$defs/point"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point_keyframe"
          }
        }
      }
    },
    "opacity_track": {
      "type": "object",
      "required": [
        "base_value"
      ],
      "additionalProperties": false,
      "properties": {
        "base_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit_scalar_keyframe"
          }
        }
      }
    },
    "anchor_track": {
      "type": "object",
      "required": [
        "base_value"
      ],
      "additionalProperties": false,
      "properties": {
        "base_value": {
          "$ref": "#/$defs/unit_point"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit_point_keyframe"
          }
        }
      }
    },
    "scale_track": {
      "type": "object",
      "required": [
        "base_value"
      ],
      "additionalProperties": false,
      "properties": {
        "base_value": {
          "$ref": "#/$defs/positive_point"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/positive_point_keyframe"
          }
        }
      }
    },
    "crop_track": {
      "type": "object",
      "required": [
        "base_value"
      ],
      "additionalProperties": false,
      "properties": {
        "base_value": {
          "$ref": "#/$defs/crop"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/crop_keyframe"
          }
        }
      }
    },
    "interpolation": {
      "oneOf": [
        {
          "enum": [
            "linear",
            "hold",
            "ease_in",
            "ease_out",
            "ease_in_out"
          ]
        },
        {
          "type": "object",
          "required": [
            "type",
            "x1",
            "y1",
            "x2",
            "y2"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "cubic_bezier"
            },
            "x1": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y1": {
              "type": "number"
            },
            "x2": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y2": {
              "type": "number"
            }
          }
        }
      ]
    },
    "scalar_keyframe": {
      "type": "object",
      "required": [
        "time",
        "value",
        "interpolation"
      ],
      "additionalProperties": false,
      "properties": {
        "time": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "type": "number"
        },
        "interpolation": {
          "$ref": "#/$defs/interpolation"
        }
      }
    },
    "point_keyframe": {
      "type": "object",
      "required": [
        "time",
        "value",
        "interpolation"
      ],
      "additionalProperties": false,
      "properties": {
        "time": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "$ref": "#/$defs/point"
        },
        "interpolation": {
          "$ref": "#/$defs/interpolation"
        }
      }
    },
    "unit_scalar_keyframe": {
      "type": "object",
      "required": [
        "time",
        "value",
        "interpolation"
      ],
      "additionalProperties": false,
      "properties": {
        "time": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "interpolation": {
          "$ref": "#/$defs/interpolation"
        }
      }
    },
    "unit_point_keyframe": {
      "type": "object",
      "required": [
        "time",
        "value",
        "interpolation"
      ],
      "additionalProperties": false,
      "properties": {
        "time": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "$ref": "#/$defs/unit_point"
        },
        "interpolation": {
          "$ref": "#/$defs/interpolation"
        }
      }
    },
    "positive_point_keyframe": {
      "type": "object",
      "required": [
        "time",
        "value",
        "interpolation"
      ],
      "additionalProperties": false,
      "properties": {
        "time": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "$ref": "#/$defs/positive_point"
        },
        "interpolation": {
          "$ref": "#/$defs/interpolation"
        }
      }
    },
    "crop_keyframe": {
      "type": "object",
      "required": [
        "time",
        "value",
        "interpolation"
      ],
      "additionalProperties": false,
      "properties": {
        "time": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "$ref": "#/$defs/crop"
        },
        "interpolation": {
          "$ref": "#/$defs/interpolation"
        }
      }
    },
    "unit_point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "positive_point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "y": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "path",
        "width",
        "height",
        "frame_rate",
        "background",
        "quality",
        "audio",
        "duration_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 2
        },
        "height": {
          "type": "integer",
          "minimum": 2
        },
        "frame_rate": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"
            }
          ]
        },
        "background": {
          "$ref": "#/$defs/colour"
        },
        "quality": {
          "enum": [
            "preview",
            "balanced",
            "high"
          ]
        },
        "audio": {
          "type": "boolean"
        },
        "duration_mode": {
          "enum": [
            "automatic",
            "explicit"
          ]
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "type",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "image",
            "audio"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "tracks"
      ],
      "additionalProperties": false,
      "properties": {
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "clips"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "mute": {
                "type": "boolean"
              },
              "gain": {
                "type": "number",
                "minimum": 0
              },
              "clips": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "asset",
                    "start",
                    "trim_start"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "asset": {
                      "type": "string"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "trim_start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "trim_end": {
                      "type": "number",
                      "minimum": 0
                    },
                    "mute": {
                      "type": "boolean"
                    },
                    "gain": {
                      "type": "number",
                      "minimum": 0
                    },
                    "gain_automation": {
                      "type": "object",
                      "required": ["keyframes"],
                      "additionalProperties": false,
                      "properties": {
                        "keyframes": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "required": ["time", "gain"],
                            "additionalProperties": false,
                            "properties": {
                              "time": {"type": "number", "minimum": 0},
                              "gain": {"type": "number", "minimum": 0},
                              "interpolation": {"enum": ["linear", "hold"]}
                            }
                          }
                        }
                      }
                    },
                    "fade_in": {
                      "type": "number",
                      "minimum": 0
                    },
                    "fade_out": {
                      "type": "number",
                      "minimum": 0
                    },
                    "fade_in_curve": {
                      "enum": ["linear", "equal_power"]
                    },
                    "fade_out_curve": {
                      "enum": ["linear", "equal_power"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "asset"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "image"
            },
            "asset": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "colour"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "solid_color"
            },
            "colour": {
              "$ref": "#/$defs/colour"
            }
          }
        }
      ]
    },
    "sizing": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "original",
                "fit",
                "cover"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "mode",
            "scale"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "scale"
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "mode",
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "stretch"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "transform": {
      "type": "object",
      "required": [
        "position",
        "anchor",
        "scale"
      ],
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/point_track"
        },
        "anchor": {
          "$ref": "#/$defs/anchor_track"
        },
        "scale": {
          "$ref": "#/$defs/scale_track"
        },
        "rotation_degrees": {
          "$ref": "#/$defs/scalar_property"
        },
        "component_modifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "position_x": { "type": "array", "items": { "$ref": "#/$defs/scalar_modifier" } },
            "position_y": { "type": "array", "items": { "$ref": "#/$defs/scalar_modifier" } },
            "scale_x": { "type": "array", "items": { "$ref": "#/$defs/scalar_modifier" } },
            "scale_y": { "type": "array", "items": { "$ref": "#/$defs/scalar_modifier" } }
          }
        }
      }
    },
    "effect": {
      "oneOf": [
        {
          "$ref": "#/$defs/amount_effect"
        },
        {
          "$ref": "#/$defs/tint_effect"
        },
        {
          "$ref": "#/$defs/gaussian_blur_effect"
        },
        {
          "$ref": "#/$defs/directional_blur_effect"
        },
        {
          "$ref": "#/$defs/zoom_blur_effect"
        },
        {
          "$ref": "#/$defs/glow_effect"
        },
        {
          "$ref": "#/$defs/chromatic_aberration_effect"
        },
        {
          "$ref": "#/$defs/vignette_effect"
        },
        {
          "$ref": "#/$defs/sharpen_effect"
        },
        {
          "$ref": "#/$defs/color_adjust_effect"
        },
        {
          "$ref": "#/$defs/camera_shake_effect"
        },
        {
          "$ref": "#/$defs/motion_blur_effect"
        }
      ]
    },
    "amount_effect": {
      "type": "object",
      "required": [
        "id",
        "type",
        "amount"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "brightness",
            "contrast",
            "saturation"
          ]
        },
        "amount": {
          "$ref": "#/$defs/scalar_property"
        }
      }
    },
    "tint_effect": {
      "type": "object",
      "required": [
        "id",
        "type",
        "colour",
        "amount"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "tint"
        },
        "colour": {
          "$ref": "#/$defs/colour"
        },
        "amount": {
          "$ref": "#/$defs/unit_scalar_property"
        }
      }
    },
    "gaussian_blur_effect": {
      "type": "object",
      "required": [
        "id",
        "type",
        "radius"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "gaussian_blur"
        },
        "radius": {
          "$ref": "#/$defs/scalar_property"
        }
      }
    },
    "directional_blur_effect": {
      "type": "object",
      "required": [
        "id",
        "type",
        "radius",
        "angle_degrees"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "directional_blur"
        },
        "radius": {
          "$ref": "#/$defs/scalar_property"
        },
        "angle_degrees": {
          "$ref": "#/$defs/scalar_property"
        }
      }
    },
    "zoom_blur_effect": {
      "type": "object",
      "required": [
        "id",
        "type",
        "radius",
        "samples",
        "anchor"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "zoom_blur"
        },
        "radius": {
          "$ref": "#/$defs/scalar_property"
        },
        "samples": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "anchor": {
          "$ref": "#/$defs/unit_point"
        },
        "direction": {
          "enum": [
            "inward",
            "outward",
            "centered"
          ]
        }
      }
    },
    "glow_effect": {
      "type": "object",
      "required": [
        "id",
        "type",
        "threshold",
        "radius",
        "intensity",
        "colour"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "glow"
        },
        "threshold": {
          "$ref": "#/$defs/scalar_property"
        },
